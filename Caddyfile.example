{$SITE_DOMAIN} {
    root * /var/www/permit-studyguide
    encode zstd gzip
    file_server

    @static path *.css *.js *.svg *.png *.webmanifest
    header @static Cache-Control "public, max-age=604800"
    header /index.html Cache-Control "no-cache"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/permit-studyguide-access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format console
    }
}
